# Database — Neon. `neon env pull` writes DATABASE_URL (pooled, app traffic)
# and DATABASE_URL_UNPOOLED (direct, migrations). Docker Compose also works.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=verify-full"

# Neon Auth (Managed Better Auth). NEON_AUTH_BASE_URL comes from `neon env pull`.
NEON_AUTH_BASE_URL="https://example.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="generate with: openssl rand -base64 32"
# Optional values returned by Neon environment setup.
NEON_AUTH_JWKS_URL="https://example.neon.tech/neondb/auth/.well-known/jwks.json"
NEON_BRANCH="main"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional distributed rate limiting for Vercel/serverless deployments.
# If omitted, the app falls back to an in-memory process-local limiter.
UPSTASH_REDIS_REST_URL="https://your-region.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Demo seed. The command creates or signs in this Neon Auth account.
DEMO_USER_EMAIL="demo@example.com"
DEMO_USER_PASSWORD="change-this-demo-password"
