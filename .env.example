# Database — Neon. `neon env pull` writes DATABASE_URL (pooled, app traffic)
# and DATABASE_URL_UNPOOLED (direct, migrations). Docker Compose also works.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=verify-full"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=verify-full"

# Neon Auth (Managed Better Auth). NEON_AUTH_BASE_URL comes from `neon env pull`.
NEON_AUTH_BASE_URL="https://example.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="generate with: openssl rand -base64 32"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
