# Runtime database connection used by the application.
DATABASE_URL="postgresql://minierp:minierp_password@localhost:5432/mini_erp"

# Direct connection used only by Prisma migrations and seed.
DATABASE_URL_UNPOOLED="postgresql://minierp:minierp_password@localhost:5432/mini_erp"

# Neon Auth
NEON_AUTH_BASE_URL="https://example.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="replace-with-at-least-32-characters"
NEON_AUTH_JWKS_URL="https://example.neon.tech/neondb/auth/.well-known/jwks.json"
NEON_BRANCH="main"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional distributed rate limiting.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional demo seed credentials.
DEMO_USER_EMAIL="demo@example.com"
DEMO_USER_PASSWORD="change-this-demo-password"
